FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements-postgres.txt ./
RUN pip install --no-cache-dir -r requirements-postgres.txt
COPY . .
RUN mkdir -p /app/data && useradd -r -u 10001 genesis && chown -R genesis:genesis /app
USER genesis
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=3)" || exit 1
CMD ["uvicorn","genesis.app:app","--host","0.0.0.0","--port","8000","--proxy-headers"]
