GENESIS_ENV=development
GENESIS_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/genesis.db
GENESIS_AUTORUN=1
GENESIS_TICK_INTERVAL_SECONDS=2
GENESIS_ALLOW_REGISTRATION=1
GENESIS_DEMO_MODE=1
GENESIS_TRUSTED_HOSTS=*
GENESIS_ADMIN_EMAIL=admin@example.com
GENESIS_ADMIN_PASSWORD=replace-with-a-strong-password
GENESIS_PUBLIC_URL=http://127.0.0.1:8000
# Optional automated billing. Leave blank for manual/invoiced mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PROFESSIONAL=
# Used only by docker-compose.postgres.yml
POSTGRES_PASSWORD=replace-with-a-strong-database-password
